/* 个人中心样式 */
.profile-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  padding: 60rpx 32rpx 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #fff;
  margin-right: 24rpx;
}

.info .name {
  display: block;
  font-size: 36rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.info .role {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.quick-actions {
  display: flex;
  background: #fff;
  margin: -40rpx 32rpx 32rpx;
  border-radius: 16rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.action-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f0f0f0;
}

.action-item:last-child {
  border-right: none;
}

.action-item .num {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.action-item .label {
  font-size: 24rpx;
  color: #999;
}

.menu-list {
  background: #fff;
  margin: 0 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-left .icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  background: #1890ff;
  border-radius: 8rpx;
}

.menu-left .title {
  font-size: 30rpx;
  color: #333;
}

.arrow {
  color: #ccc;
  font-size: 28rpx;
}

.logout-btn {
  margin: 48rpx 32rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  color: #ff4d4f;
}