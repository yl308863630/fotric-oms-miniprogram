/* 采购订单详情样式 */
.detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.loading, .empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
  font-size: 28rpx;
}

.section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.status-section {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.status-row:not(:last-child) {
  border-bottom: 1rpx solid rgba(255,255,255,0.2);
}

.status-label {
  font-size: 28rpx;
  opacity: 0.8;
}

.status-value {
  font-size: 28rpx;
  font-weight: 600;
}

.status-value.待确认 { background: #fff7e6; color: #fa8c16; padding: 4rpx 16rpx; border-radius: 4rpx; }
.status-value.待盖章 { background: #fff0f6; color: #eb2f96; padding: 4rpx 16rpx; border-radius: 4rpx; }
.status-value.待发货 { background: #fff7e6; color: #fa8c16; padding: 4rpx 16rpx; border-radius: 4rpx; }
.status-value.待签收 { background: #fff7e6; color: #fa8c16; padding: 4rpx 16rpx; border-radius: 4rpx; }
.status-value.待对账 { background: #f9f0ff; color: #722ed1; padding: 4rpx 16rpx; border-radius: 4rpx; }
.status-value.待开票 { background: #f9f0ff; color: #722ed1; padding: 4rpx 16rpx; border-radius: 4rpx; }
.status-value.待结算 { background: #fff7e6; color: #fa8c16; padding: 4rpx 16rpx; border-radius: 4rpx; }
.status-value.已完成 { background: #f0f5ff; color: #2f54eb; padding: 4rpx 16rpx; border-radius: 4rpx; }
.status-value.已取消 { background: #fff1f0; color: #ff4d4f; padding: 4rpx 16rpx; border-radius: 4rpx; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  color: #999;
  width: 200rpx;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  text-align: right;
}

.info-item .value.amount {
  font-weight: bold;
  color: #ff4d4f;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.1);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 40rpx;
  background: #1890ff;
  color: #fff;
  border: none;
}

.action-btn.warn {
  background: #ff4d4f;
}

.action-btn::after {
  border: none;
}