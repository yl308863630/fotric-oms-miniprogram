<view class="contracts-page"><scroll-view class="contract-list" scroll-y><view class="contract-card" wx:for="{{contracts}}" wx:key="id"><view class="contract-header"><text class="contract-no">{{item.contractNo}}</text><text class="status {{item.status}}">{{item.statusText || item.status}}</text></view><view class="contract-info"><view><text class="label">甲方：</text><text class="value">{{item.partyATitle}}</text></view><view><text class="label">乙方：</text><text class="value">{{item.partyBTitle}}</text></view><view><text class="label">金额：</text><text class="value amount">¥{{item.amount}}</text></view></view></view><view class="empty" wx:if="{{!contracts.length && !loading}}"><text>暂无合同</text></view></scroll-view></view>