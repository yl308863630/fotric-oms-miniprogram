.contracts-page{min-height:100vh;background:#f5f5f5}.contract-list{height:100vh;padding:20rpx}.contract-card{background:#fff;border-radius:16rpx;padding:30rpx;margin-bottom:20rpx}.contract-header{display:flex;justify-content:space-between;margin-bottom:20rpx}.contract-no{font-size:30rpx;font-weight:bold}.status{font-size:24rpx;padding:4rpx 16rpx;border-radius:20rpx}.status.SIGNED{background:#f6ffed;color:#52c41a}.status.PENDING{background:#fff7e6;color:#fa8c16}.status.REJECTED{background:#fff1f0;color:#ff4d4f}.contract-info view{display:flex;margin-bottom:10rpx;font-size:28rpx}.contract-info .label{color:#999;width:120rpx}.contract-info .value{color:#333}.contract-info .amount{font-weight:bold;color:#ff4d4f}.empty{text-align:center;padding:60rpx;color:#999}