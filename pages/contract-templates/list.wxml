<!-- 合同模板管理 -->
<view class="template-page">
  <!-- 模板列表 -->
  <scroll-view scroll-y class="template-list">
    <view class="template-card" wx:for="{{templates}}" wx:key="id">
      <view class="card-header">
        <text class="name">{{item.name}}</text>
        <view class="actions">
          <text class="action-btn" data-item="{{item}}" bindtap="showEditModal">编辑</text>
          <text class="action-btn delete" data-id="{{item.id}}" bindtap="deleteTemplate">删除</text>
        </view>
      </view>
      <view class="card-body">
        <text class="content">{{item.content}}</text>
      </view>
      <view class="card-footer" wx:if="{{item.remark}}">
        <text>备注：{{item.remark}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!templates.length && !loading}}">暂无模板</view>
    <view class="load-more" wx:if="{{loading}}">加载中...</view>
  </scroll-view>

  <!-- 新建按钮 -->
  <view class="add-btn" bindtap="showCreateModal">+ 新建模板</view>

  <!-- 新建/编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideModal"></view>
  <view class="modal {{showModal ? 'show' : ''}}">
    <view class="modal-header">
      <text class="title">{{modalType === 'create' ? '新建模板' : '编辑模板'}}</text>
      <text class="close" bindtap="hideModal">×</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="label">模板名称 <text class="required">*</text></text>
        <input class="input" placeholder="请输入模板名称" value="{{form.name}}" bindinput="onNameInput" />
      </view>
      <view class="form-item vertical">
        <text class="label">模板内容 <text class="required">*</text></text>
        <textarea class="textarea" placeholder="请输入模板内容，支持变量：{{甲方名称}}、{{订单号}}、{{金额}}" value="{{form.content}}" bindinput="onContentInput" />
      </view>
      <view class="form-item">
        <text class="label">备注</text>
        <input class="input" placeholder="请输入备注" value="{{form.remark}}" bindinput="onRemarkInput" />
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn cancel" bindtap="hideModal">取消</button>
      <button class="btn confirm" bindtap="saveTemplate" loading="{{submitting}}">保存</button>
    </view>
  </view>
</view>