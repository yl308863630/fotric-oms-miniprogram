<!-- 合作伙伴详情/新建/编辑页面 -->
<view class="detail-page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  
  <scroll-view wx:else class="form-container" scroll-y>
    <!-- 基本信息 -->
    <view class="section">
      <view class="section-title">基本信息</view>
      
      <view class="form-item">
        <text class="required">*</text>
        <text class="label">抬头信息</text>
        <input class="input" value="{{formData.title}}" data-field="title" bindinput="onInput" placeholder="请输入抬头信息（合同/发票抬头）" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">类型</text>
        <view class="type-selector" wx:if="{{action !== 'view'}}">
          <view class="type-btn {{formData.type === 'A' ? 'active' : ''}}" data-type="A" bindtap="onTypeChange">甲方</view>
          <view class="type-btn {{formData.type === 'B' ? 'active' : ''}}" data-type="B" bindtap="onTypeChange">乙方</view>
        </view>
        <text class="value" wx:else>{{formData.type === 'A' ? '甲方' : '乙方'}}</text>
      </view>
      
      <view class="form-item">
        <text class="label">编码</text>
        <input class="input" value="{{formData.code}}" data-field="code" bindinput="onInput" placeholder="请输入编码" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">是否为交付方</text>
        <switch checked="{{formData.isDeliveryParty}}" data-field="isDeliveryParty" bindchange="onSwitchChange" disabled="{{action === 'view'}}" />
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="section">
      <view class="section-title">联系方式</view>
      
      <view class="form-item">
        <text class="label">联系人</text>
        <input class="input" value="{{formData.contactPerson}}" data-field="contactPerson" bindinput="onInput" placeholder="请输入联系人" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">电话</text>
        <input class="input" value="{{formData.contactPhone}}" data-field="contactPhone" bindinput="onInput" placeholder="请输入电话" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">邮箱</text>
        <input class="input" value="{{formData.email}}" data-field="email" bindinput="onInput" placeholder="请输入邮箱" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">地址</text>
        <input class="input" value="{{formData.address}}" data-field="address" bindinput="onInput" placeholder="请输入地址" disabled="{{action === 'view'}}" />
      </view>
    </view>

    <!-- 税务信息 -->
    <view class="section">
      <view class="section-title">税务信息</view>
      
      <view class="form-item">
        <text class="label">税号</text>
        <input class="input" value="{{formData.taxNumber}}" data-field="taxNumber" bindinput="onInput" placeholder="请输入税号" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">开户行</text>
        <input class="input" value="{{formData.bankName}}" data-field="bankName" bindinput="onInput" placeholder="请输入开户行" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">银行账号</text>
        <input class="input" value="{{formData.bankAccount}}" data-field="bankAccount" bindinput="onInput" placeholder="请输入银行账号" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">开户行地址</text>
        <input class="input" value="{{formData.bankAddress}}" data-field="bankAddress" bindinput="onInput" placeholder="请输入开户行地址" disabled="{{action === 'view'}}" />
      </view>
    </view>

    <!-- 备注 -->
    <view class="section">
      <view class="section-title">备注</view>
      <textarea class="textarea" value="{{formData.remark}}" data-field="remark" bindinput="onInput" placeholder="请输入备注" disabled="{{action === 'view'}}" />
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar" wx:if="{{action !== 'view'}}">
      <button class="btn-submit" bindtap="handleSubmit" disabled="{{submitting}}">
        {{submitting ? '提交中...' : (action === 'create' ? '新增合作伙伴' : '保存修改')}}
      </button>
    </view>
    
    <view class="action-bar" wx:if="{{action === 'view' && canSave}}">
      <button class="btn-edit" bindtap="handleEdit">编辑</button>
      <button class="btn-delete" bindtap="handleDelete">删除</button>
    </view>
  </scroll-view>
</view>