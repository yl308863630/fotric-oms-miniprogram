/* 合作伙伴样式 */
.partners-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.search-bar {
  padding: 20rpx;
  background: #fff;
}

.search-input {
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

/* 新增按钮 */
.toolbar {
  padding: 0 20rpx 20rpx;
  background: #fff;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.partner-list {
  height: calc(100vh - 260rpx);
  padding: 20rpx;
}

.partner-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.partner-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.partner-title {
  font-size: 32rpx;
  font-weight: bold;
  flex: 1;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.partner-type {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  background: #e6f7ff;
  color: #1890ff;
  border-radius: 20rpx;
}

.action-btn {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.partner-info view {
  display: flex;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

.partner-info .label {
  color: #999;
  width: 120rpx;
}

.partner-info .value {
  color: #333;
}

.delivery-tag {
  margin-top: 12rpx;
}

.delivery-tag text {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  background: #f6ffed;
  color: #52c41a;
  border-radius: 4rpx;
}

.empty, .load-more {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

/* 操作菜单 */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.action-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 101;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.action-sheet.show {
  transform: translateY(0);
}

.action-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 30rpx;
  color: #333;
}

.action-item:last-child {
  border-bottom: none;
}

.action-item.cancel {
  color: #999;
  justify-content: center;
  margin-top: 16rpx;
}

.action-item.warn {
  color: #ff4d4f;
}

.action-icon {
  margin-right: 20rpx;
  font-size: 32rpx;
}