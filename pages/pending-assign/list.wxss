/* 待指派列表 */
.pending-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.search-bar {
  padding: 20rpx;
  background: #fff;
}

.search-input {
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #fff7e6;
}

.count {
  font-size: 26rpx;
  color: #fa8c16;
}

.batch-btn {
  padding: 12rpx 24rpx;
  background: #fa8c16;
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
}

.order-list {
  height: calc(100vh - 180rpx);
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-left: 8rpx solid #fa8c16;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  background: #fff7e6;
  color: #fa8c16;
}

.card-body {
  padding: 20rpx 24rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row .label {
  font-size: 26rpx;
  color: #999;
  width: 160rpx;
}

.info-row .value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.info-row .amount {
  font-weight: bold;
  color: #ff4d4f;
}

.empty, .load-more {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}