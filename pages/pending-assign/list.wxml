<!-- 待指派订单列表 -->
<view class="pending-page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索订单号/甲方名称" bindconfirm="onSearch" />
  </view>

  <!-- 批量操作 -->
  <view class="top-bar" wx:if="{{orders.length > 0}}">
    <text class="count">共 {{orders.length}} 单待指派</text>
    <view class="batch-btn" bindtap="goToBatchAssign" wx:if="{{canAssign}}">批量指派</view>
  </view>

  <!-- 订单列表 -->
  <scroll-view scroll-y class="order-list">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goToDetail">
      <view class="card-header">
        <text class="order-no">{{item.platformOrderNo || item.omsOrderNo || item.id}}</text>
        <text class="status-badge">待指派</text>
      </view>
      
      <view class="card-body">
        <view class="info-row">
          <text class="label">甲方：</text>
          <text class="value">{{item.partyATitle || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="label">平台：</text>
          <text class="value">{{item.platformName || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="label">金额：</text>
          <text class="value amount">¥{{item.amount || item.taxIncludedTotal || 0}}</text>
        </view>
        <view class="info-row">
          <text class="label">创建时间：</text>
          <text class="value">{{item.createTime || '-'}}</text>
        </view>
      </view>
    </view>
    
    <view class="empty" wx:if="{{!orders.length && !loading}}">
      <text>暂无待指派订单</text>
    </view>
    
    <view class="load-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:if="{{!hasMore && orders.length}}">
      <text>没有更多了</text>
    </view>
  </scroll-view>
</view>