/* Dashboard 样式 */
.dashboard {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #fff;
}

.info {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
}

.role {
  font-size: 24rpx;
  opacity: 0.8;
}

.logout {
  padding: 10rpx 30rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 快捷入口 */
.quick-entry {
  display: flex;
  background: #fff;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
}

.entry-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.entry-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e6f7ff;
  border-radius: 20rpx;
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.entry-icon.pending {
  background: #fff7e6;
}

.entry-label {
  font-size: 24rpx;
  color: #666;
}

.entry-badge {
  position: absolute;
  top: -8rpx;
  right: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* 统计卡片 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  background: #fff;
}

.stat-card {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #1890ff;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
}

/* 列表区域 */
.section {
  margin-top: 20rpx;
  background: #fff;
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
}

.more {
  font-size: 26rpx;
  color: #999;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
}

.order-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-item:last-child {
  border-bottom: none;
}

.order-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: bold;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  color: #666;
}

.order-status.PENDING {
  background: #fff7e6;
  color: #fa8c16;
}

.order-status.CONFIRMED {
  background: #e6f7ff;
  color: #1890ff;
}

.order-status.SHIPPED {
  background: #f6ffed;
  color: #52c41a;
}

.order-detail {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.buyer {
  font-size: 28rpx;
  color: #333;
}

.amount {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
}

.loading {
  padding: 40rpx;
  text-align: center;
  color: #999;
}