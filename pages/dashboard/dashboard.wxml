<!-- Dashboard 首页 -->
<view class="dashboard">
  <!-- 顶部用户信息 -->
  <view class="header">
    <view class="user-info">
      <image class="avatar" src="/images/avatar.png" mode="aspectFill"></image>
      <view class="info">
        <text class="name">{{userInfo.realName || userInfo.username}}</text>
        <text class="role">{{userInfo.role || '员工'}}</text>
      </view>
    </view>
    <view class="logout" bindtap="handleLogout">退出</view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-entry">
    <view class="entry-item" bindtap="goToPendingAssign">
      <view class="entry-icon pending">📤</view>
      <text class="entry-label">待指派</text>
      <view class="entry-badge" wx:if="{{stats.pendingAssignCount > 0}}">{{stats.pendingAssignCount}}</view>
    </view>
    <view class="entry-item" bindtap="goToContractTemplates">
      <view class="entry-icon">📝</view>
      <text class="entry-label">合同模板</text>
    </view>
    <view class="entry-item" bindtap="goToReconciliation">
      <view class="entry-icon">💰</view>
      <text class="entry-label">对账</text>
    </view>
    <view class="entry-item" bindtap="goToContracts">
      <view class="entry-icon">📃</view>
      <text class="entry-label">合同</text>
    </view>
    <view class="entry-item" bindtap="goToChainObserve" wx:if="{{canViewChain}}">
      <view class="entry-icon chain">🔗</view>
      <text class="entry-label">主链观察</text>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-grid">
    <view class="stat-card" bindtap="goToOrders">
      <text class="stat-value">{{stats.totalOrders}}</text>
      <text class="stat-label">总订单</text>
    </view>
    <view class="stat-card" bindtap="goToOrders">
      <text class="stat-value" style="color: #faad14;">{{stats.pendingOrders}}</text>
      <text class="stat-label">待处理</text>
    </view>
    <view class="stat-card" bindtap="goToProducts">
      <text class="stat-value">{{stats.totalProducts}}</text>
      <text class="stat-label">商品数</text>
    </view>
    <view class="stat-card" bindtap="goToPartners">
      <text class="stat-value">{{stats.totalPartners}}</text>
      <text class="stat-label">合作方</text>
    </view>
  </view>

  <!-- 最近订单 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">最近订单</text>
      <text class="more" bindtap="goToOrders">更多 ></text>
    </view>
    <view class="order-list">
      <view class="order-item" wx:for="{{recentOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="goToOrderDetail">
        <view class="order-info">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-status {{item.status}}">{{item.statusText || item.status}}</text>
        </view>
        <view class="order-detail">
          <text class="buyer">{{item.partyAName || item.buyerName}}</text>
          <text class="amount">¥{{item.amount}}</text>
        </view>
        <view class="order-time">{{item.createTime}}</view>
      </view>
      <view class="empty" wx:if="{{!recentOrders.length && !loading}}">
        <text>暂无订单</text>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>