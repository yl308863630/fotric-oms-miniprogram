/* 合并对账页面 */
.reconciliation-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-total {
  font-size: 26rpx;
  color: #ff4d4f;
  font-weight: 600;
}

/* 已选订单 */
.selected-list {
  max-height: 300rpx;
  overflow-y: auto;
}

.selected-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.selected-item:last-child {
  border-bottom: none;
}

.item-info {
  flex: 1;
}

.order-no {
  font-size: 26rpx;
  color: #333;
  display: block;
}

.party {
  font-size: 24rpx;
  color: #999;
}

.item-right {
  display: flex;
  align-items: center;
}

.amount {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 500;
  margin-right: 20rpx;
}

.remove-btn {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

/* 可选订单 */
.order-list {
  height: 500rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.order-item.selected {
  background: #e6f7ff;
  border: 2rpx solid #1890ff;
}

.checkbox-item {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: #1890ff;
  border-color: #1890ff;
}

.checkbox.checked::after {
  content: '✓';
  color: #fff;
  font-size: 24rpx;
}

.order-info {
  flex: 1;
}

.order-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.order-main .order-no {
  font-weight: 500;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  background: #f6ffed;
  color: #52c41a;
}

.order-sub {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item .label {
  font-size: 28rpx;
  color: #333;
  min-width: 180rpx;
}

.required {
  color: #ff4d4f;
}

.input-wrapper {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.input-wrapper .value,
.input-wrapper .placeholder {
  font-size: 28rpx;
  color: #333;
}

.input-wrapper .placeholder {
  color: #999;
}

.input-wrapper .arrow {
  color: #ccc;
  margin-left: 16rpx;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

/* 底部 */
.bottom-space {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.08);
}

.total-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.total-info text:first-child {
  font-size: 24rpx;
  color: #666;
}

.total-amount {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: 600;
}

.submit-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.modal-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 101;
}

.modal-bottom.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
}

.modal-content {
  height: 50vh;
  padding: 0 32rpx;
}

.option-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.empty {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

.load-more {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}