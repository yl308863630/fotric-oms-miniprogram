<!-- 订单详情页 -->
<view class="detail-page">
  <scroll-view scroll-y class="detail-scroll" wx:if="{{detail}}">
    <!-- 订单状态 -->
    <view class="status-card">
      <view class="status-header">
        <text class="status-label">订单状态</text>
        <text class="status-value {{detail.status}}">{{detail.status || '待指派'}}</text>
      </view>
      <view class="status-info">
        <text>订单号：{{detail.platformOrderNo || detail.omsOrderNo || detail.id}}</text>
      </view>
    </view>

    <!-- 甲方信息 -->
    <view class="section">
      <view class="section-title">甲方信息</view>
      <view class="info-list">
        <view class="info-item">
          <text class="label">甲方名称</text>
          <text class="value">{{detail.partyATitle || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">顶层客户</text>
          <text class="value">{{detail.topLevelCustomerName || '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 平台信息 -->
    <view class="section">
      <view class="section-title">平台信息</view>
      <view class="info-list">
        <view class="info-item">
          <text class="label">平台</text>
          <text class="value">{{detail.platformName || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">平台订单号</text>
          <text class="value">{{detail.platformOrderNo || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">支付方式</text>
          <text class="value">{{detail.paymentMethod || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">订单类型</text>
          <text class="value">{{detail.orderType || '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 交付方信息 -->
    <view class="section" wx:if="{{detail.deliveryParty}}">
      <view class="section-title">交付方信息</view>
      <view class="info-list">
        <view class="info-item">
          <text class="label">交付方</text>
          <text class="value">{{detail.deliveryParty || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">采购价</text>
          <text class="value">¥{{detail.deliveryPartyPurchasePrice || 0}}</text>
        </view>
      </view>
    </view>

    <!-- 收货信息 -->
    <view class="section">
      <view class="section-title">收货信息</view>
      <view class="info-list">
        <view class="info-item">
          <text class="label">收货人</text>
          <text class="value">{{detail.receiverName || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">联系电话</text>
          <text class="value">{{detail.receiverPhone || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">收货地址</text>
          <text class="value">{{detail.receiverAddress || '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 线下销售 -->
    <view class="section" wx:if="{{detail.offlineSales === '是'}}">
      <view class="section-title">线下销售</view>
      <view class="info-list">
        <view class="info-item">
          <text class="label">线下合同号</text>
          <text class="value">{{detail.offlineContractNo || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">线下出货价</text>
          <text class="value">¥{{detail.offlineShippingPrice || 0}}</text>
        </view>
        <view class="info-item">
          <text class="label">扣点</text>
          <text class="value">{{detail.deductionRate || 0}}%</text>
        </view>
      </view>
    </view>

    <!-- 商品明细 -->
    <view class="section">
      <view class="section-title">商品明细</view>
      <view class="item-list" wx:if="{{detail.items && detail.items.length}}">
        <view class="item-row" wx:for="{{detail.items}}" wx:key="index">
          <view class="item-info">
            <text class="item-name">{{item.productName}}</text>
            <text class="item-model" wx:if="{{item.model}}">{{item.model}}</text>
          </view>
          <view class="item-right">
            <text class="item-qty">x{{item.quantity}}</text>
            <text class="item-amount">¥{{item.amount || (item.price * item.quantity)}}</text>
          </view>
        </view>
        <view class="total-row">
          <text>合计</text>
          <text class="total-amount">¥{{detail.amount || detail.taxIncludedTotal || 0}}</text>
        </view>
      </view>
      <view class="empty" wx:else>暂无商品</view>
    </view>

    <!-- 主链视角：子订单 -->
    <view class="section" wx:if="{{childOrders.length > 0}}">
      <view class="section-title">
        <text>子订单</text>
        <text class="section-count">{{childOrders.length}}单</text>
      </view>
      <view class="child-order-list">
        <view class="child-order-card" wx:for="{{childOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="goToChildDetail">
          <view class="child-header">
            <text class="child-no">{{item.platformOrderNo || item.omsOrderNo}}</text>
            <text class="child-status {{item.status}}">{{item.status}}</text>
          </view>
          <view class="child-info">
            <text>交付方：{{item.deliveryParty || '-'}}</text>
            <text class="child-amount">¥{{item.amount || 0}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="section" wx:elif="{{childOrdersLoading}}">
      <view class="section-title">子订单</view>
      <view class="loading-small">加载中...</view>
    </view>

    <!-- 物流信息 -->
    <view class="section" wx:if="{{detail.shippingParty || detail.platformReconciliationNo}}">
      <view class="section-title">物流信息</view>
      <view class="info-list">
        <view class="info-item">
          <text class="label">物流公司</text>
          <text class="value">{{detail.shippingParty || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">快递单号</text>
          <text class="value">{{detail.platformReconciliationNo || '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 发票与结算 -->
    <view class="section" wx:if="{{detail.invoiceNumber || detail.settlementNo}}">
      <view class="section-title">发票与结算</view>
      <view class="info-list">
        <view class="info-item">
          <text class="label">发票号码</text>
          <text class="value">{{detail.invoiceNumber || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">甲方对账单号</text>
          <text class="value">{{detail.partyReconciliationNo || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">结算单号</text>
          <text class="value">{{detail.settlementNo || '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 商务ERP录单 -->
    <view class="section">
      <view class="section-title">商务ERP录单</view>
      <view class="info-list" wx:if="{{detail.erpEntryStatus}}">
        <view class="info-item">
          <text class="label">录单状态</text>
          <text class="value">{{detail.erpEntryStatus}}</text>
        </view>
        <view class="info-item">
          <text class="label">录单人</text>
          <text class="value">{{detail.erpEntryOperator || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">录单时间</text>
          <text class="value">{{detail.erpEntryTime || '-'}}</text>
        </view>
      </view>
      <view class="empty" wx:else>未录单</view>
    </view>

    <!-- 创建信息 -->
    <view class="section">
      <view class="section-title">创建信息</view>
      <view class="info-list">
        <view class="info-item">
          <text class="label">创建时间</text>
          <text class="value">{{detail.createTime || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">备注</text>
          <text class="value">{{detail.remark || '-'}}</text>
        </view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{detail}}">
    <view class="action-btn-list">
      <view class="action-btn" bindtap="openActionModal" data-type="assign" wx:if="{{detail.status === '待指派' && canAssign}}">
        <text>指派</text>
      </view>
      <view class="action-btn" bindtap="openActionModal" data-type="edit" wx:if="{{canEdit}}">
        <text>编辑</text>
      </view>
      <view class="action-btn" bindtap="openActionModal" data-type="confirm" wx:if="{{detail.status === '待确认订单' && canConfirm}}">
        <text>确认</text>
      </view>
      <view class="action-btn" bindtap="openActionModal" data-type="ship" wx:if="{{detail.status === '待合同盖章' && canShip}}">
        <text>发货</text>
      </view>
      <view class="action-btn" bindtap="openActionModal" data-type="receipt" wx:if="{{detail.status === '已发货' && canUploadReceipt}}">
        <text>签收单</text>
      </view>
      <view class="action-btn primary" bindtap="openActionModal" data-type="settle" wx:if="{{(detail.status === '已对账未开票' || detail.status === '已开票待结算') && canSettle}}">
        <text>结算</text>
      </view>
      <view class="action-btn" bindtap="openActionModal" data-type="erp" wx:if="{{canErpEntry}}">
        <text>ERP</text>
      </view>
      <view class="action-btn warn" bindtap="openActionModal" data-type="return" wx:if="{{detail.status !== '已取消' && detail.status !== '已退回' && canReturn}}">
        <text>退回</text>
      </view>
    </view>
  </view>

  <!-- 操作弹窗 -->
  <view class="modal-mask" wx:if="{{showActionModal}}" bindtap="closeModal"></view>
  <view class="modal {{showActionModal ? 'show' : ''}}">
    <view class="modal-header">
      <text class="modal-title">
        {{actionType === 'confirm' ? '确认订单' : 
          actionType === 'ship' ? '发货' : 
          actionType === 'receipt' ? '上传签收单' : 
          actionType === 'settle' ? '结算' : 
          actionType === 'erp' ? '商务ERP录单' : 
          actionType === 'assign' ? '指派订单' : 
          actionType === 'edit' ? '编辑订单' :
          actionType === 'return' ? '退回订单' : '操作'}}
      </text>
      <text class="modal-close" bindtap="closeModal">×</text>
    </view>

    <view class="modal-content">
      <!-- 确认订单 -->
      <view wx:if="{{actionType === 'confirm'}}">
        <view class="confirm-tip">确认后将进入"待合同盖章"状态</view>
        <button class="modal-btn" bindtap="submitConfirm" loading="{{actionLoading}}">确认</button>
      </view>

      <!-- 指派订单 -->
      <view wx:if="{{actionType === 'assign'}}">
        <view class="form-item" bindtap="showDeliveryPartyPicker">
          <text class="label">交付方 <text class="required">*</text></text>
          <view class="input-wrapper">
            <text class="{{assignForm.deliveryParty ? 'value' : 'placeholder'}}">{{assignForm.deliveryParty || '请选择交付方'}}</text>
            <text class="arrow">></text>
          </view>
        </view>
        <view class="form-item">
          <text class="label">采购价</text>
          <input class="input" type="digit" placeholder="请输入采购价" value="{{assignForm.deliveryPartyPurchasePrice}}" bindinput="onAssignPriceChange" />
        </view>
        <view class="form-item">
          <text class="label">支付方式</text>
          <picker mode="selector" range="{{['全款', '账期', '背靠背']}}" bindchange="onAssignPaymentChange">
            <view class="picker-value">{{assignForm.paymentMethod || '请选择'}}</view>
          </picker>
        </view>
        <view class="form-item">
          <text class="label">合同模板</text>
          <picker mode="selector" range="{{['标准合同', '简易合同', '第三方合同']}}" bindchange="onAssignTemplateChange">
            <view class="picker-value">{{assignForm.contractTemplate || '请选择'}}</view>
          </picker>
        </view>
        <button class="modal-btn" bindtap="submitAssign" loading="{{actionLoading}}">确认指派</button>
      </view>

      <!-- 编辑订单 -->
      <view wx:if="{{actionType === 'edit'}}">
        <view class="form-item">
          <text class="label">甲方名称</text>
          <input class="input" placeholder="请输入甲方名称" value="{{detail.partyATitle}}" />
        </view>
        <view class="form-item">
          <text class="label">平台订单号</text>
          <input class="input" placeholder="请输入平台订单号" value="{{detail.platformOrderNo}}" />
        </view>
        <view class="form-item">
          <text class="label">收货人</text>
          <input class="input" placeholder="请输入收货人" value="{{detail.receiverName}}" />
        </view>
        <view class="form-item">
          <text class="label">联系电话</text>
          <input class="input" placeholder="请输入电话" value="{{detail.receiverPhone}}" />
        </view>
        <view class="form-item">
          <text class="label">收货地址</text>
          <input class="input" placeholder="请输入地址" value="{{detail.receiverAddress}}" />
        </view>
        <button class="modal-btn" bindtap="submitEdit" loading="{{actionLoading}}">保存</button>
      </view>

      <!-- 退回订单 -->
      <view wx:if="{{actionType === 'return'}}">
        <view class="confirm-tip">确定要退回此订单吗？退回后订单将返还给上一手处理。</view>
        <button class="modal-btn warn" bindtap="submitReturn" loading="{{actionLoading}}">确认退回</button>
      </view>

      <!-- 发货 -->
      <view wx:if="{{actionType === 'ship'}}">
        <view class="form-item">
          <text class="label">物流公司</text>
          <input class="input" placeholder="请输入物流公司" value="{{shipForm.logisticsCompany}}" bindinput="onLogisticsChange" />
        </view>
        <view class="form-item">
          <text class="label">快递单号</text>
          <input class="input" placeholder="请输入快递单号" value="{{shipForm.trackingNumber}}" bindinput="onTrackingNoChange" />
        </view>
        <button class="modal-btn" bindtap="submitShip" loading="{{actionLoading}}">确认发货</button>
      </view>

      <!-- 上传签收单 -->
      <view wx:if="{{actionType === 'receipt'}}">
        <view class="upload-box" bindtap="uploadReceipt">
          <view wx:if="{{!receiptFile}}">
            <text class="upload-icon">+</text>
            <text>点击上传签收单</text>
          </view>
          <view wx:else>
            <text>{{receiptFile.name}}</text>
          </view>
        </view>
        <button class="modal-btn" bindtap="submitReceipt" loading="{{actionLoading}}">上传</button>
      </view>

      <!-- 结算 -->
      <view wx:if="{{actionType === 'settle'}}">
        <view class="form-item">
          <text class="label">发票号码 <text class="required">*</text></text>
          <input class="input" placeholder="请输入发票号码" value="{{settleForm.invoiceNumber}}" bindinput="onInvoiceNumberChange" />
        </view>
        <view class="form-item">
          <text class="label">甲方对账单号</text>
          <input class="input" placeholder="请输入对账单号" value="{{settleForm.partyReconciliationNo}}" bindinput="onPartyReconciliationNoChange" />
        </view>
        <view class="form-item">
          <text class="label">结算单号</text>
          <input class="input" placeholder="请输入结算单号" value="{{settleForm.settlementNo}}" bindinput="onSettlementNoChange" />
        </view>
        <button class="modal-btn" bindtap="submitSettle" loading="{{actionLoading}}">保存结算</button>
      </view>

      <!-- 商务ERP录单 -->
      <view wx:if="{{actionType === 'erp'}}">
        <view class="form-item">
          <text class="label">录单状态</text>
          <picker mode="selector" range="{{['未录单', '已录单', '录单中']}}" bindchange="onErpStatusChange">
            <view class="picker-value">{{erpForm.erpEntryStatus || '请选择'}}</view>
          </picker>
        </view>
        <view class="upload-box" bindtap="uploadErpScreenshot">
          <view wx:if="{{!erpFile}}">
            <text class="upload-icon">+</text>
            <text>上传录单截图</text>
          </view>
          <view wx:else>
            <text>{{erpFile.name}}</text>
          </view>
        </view>
        <button class="modal-btn" bindtap="submitErp" loading="{{actionLoading}}">保存</button>
      </view>
    </view>
  </view>

  <!-- 交付方选择弹窗 -->
  <view class="modal-mask" wx:if="{{deliveryPartyList.length > 0 && actionType === 'assign'}}" bindtap="closeDeliveryPartyPicker"></view>
  <view class="modal-bottom {{deliveryPartyList.length > 0 && actionType === 'assign' ? 'show' : ''}}" wx:if="{{actionType === 'assign'}}">
    <view class="modal-header">
      <text class="modal-title">选择交付方</text>
      <text class="modal-close" bindtap="closeModal">×</text>
    </view>
    <scroll-view scroll-y class="modal-content">
      <view class="option-item" wx:for="{{deliveryPartyList}}" wx:key="id" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="selectDeliveryParty">
        <text>{{item.title}}</text>
      </view>
      <view class="load-more" wx:if="{{deliveryPartyLoading}}">加载中...</view>
    </scroll-view>
  </view>
</view>