<!-- 订单列表 -->
<view class="orders-page">
  <!-- 顶部操作栏 -->
  <view class="top-bar">
    <scroll-view class="status-tabs" scroll-x>
      <view class="tab {{statusFilter === '' ? 'active' : ''}}" data-status="" bindtap="onStatusChange" >全部</view>
      <view class="tab {{statusFilter === 'PENDING' ? 'active' : ''}}" data-status="PENDING" bindtap="onStatusChange" >待处理</view>
      <view class="tab {{statusFilter === 'CONFIRMED' ? 'active' : ''}}" data-status="CONFIRMED" bindtap="onStatusChange" >已确认</view>
      <view class="tab {{statusFilter === 'SHIPPED' ? 'active' : ''}}" data-status="SHIPPED" bindtap="onStatusChange" >已发货</view>
      <view class="tab {{statusFilter === 'COMPLETED' ? 'active' : ''}}" data-status="COMPLETED" bindtap="onStatusChange" >已完成</view>
    </scroll-view>
    <view class="add-btn" bindtap="goToCreate">+ 新建</view>
  </view>
  
  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y>
    <view class="order-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goToDetail" >
      <view class="card-header">
        <text class="order-no">{{item.masterNo || item.orderNo}}</text>
        <text class="status-badge {{item.masterStatus || item.status}}">{{item.masterStatusText || item.masterStatus || item.status}}</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="label">甲方：</text>
          <text class="value">{{item.partyATitle || '未知'}}</text>
        </view>
        <view class="info-row">
          <text class="label">平台：</text>
          <text class="value">{{item.platformName || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="label">金额：</text>
          <text class="value amount">¥{{item.amount || item.totalAmount || 0}}</text>
        </view>
      </view>
      <view class="card-footer">
        <text class="time">{{item.createTime}}</text>
        <text class="more">查看详情 ></text>
      </view>
    </view>
    <!-- 空状态 -->
    <view class="empty" wx:if="{{!orders.length && !loading}}">
      <text>暂无订单</text>
    </view>
    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:if="{{!hasMore && orders.length}}">
      <text>没有更多了</text>
    </view>
  </scroll-view>
</view>