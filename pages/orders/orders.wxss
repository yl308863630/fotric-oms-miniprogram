/* 订单列表样式 */
.orders-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.search-bar {
  padding: 20rpx;
  background: #fff;
}

.search-input {
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.status-tabs {
  flex: 1;
  display: flex;
  white-space: nowrap;
}

.tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 24rpx;
  background: #f0f0f0;
}

.tab.active {
  background: #1890ff;
  color: #fff;
}

.action-btns {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.batch-btn {
  padding: 12rpx 24rpx;
  background: #52c41a;
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
}

.add-btn {
  width: 100rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #1890ff;
  color: #fff;
  font-size: 26rpx;
  border-radius: 28rpx;
}

.order-list {
  height: calc(100vh - 240rpx);
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.header-right {
  display: flex;
  align-items: center;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.status-badge.待指派, .status-badge.PENDING, .status-badge.DRAFT {
  background: #fff7e6;
  color: #fa8c16;
}

.status-badge.待确认订单, .status-badge.CONFIRMED {
  background: #e6f7ff;
  color: #1890ff;
}

.status-badge.待合同盖章 {
  background: #fff0f6;
  color: #eb2f96;
}

.status-badge.已发货, .status-badge.SHIPPED {
  background: #f6ffed;
  color: #52c41a;
}

.status-badge.已对账未开票 {
  background: #f9f0ff;
  color: #722ed1;
}

.status-badge.已开票待结算, .status-badge.SETTLING {
  background: #fff7e6;
  color: #fa8c16;
}

.status-badge.已完成, .status-badge.COMPLETED {
  background: #f0f5ff;
  color: #2f54eb;
}

.status-badge.已取消, .status-badge.CANCELLED {
  background: #fff1f0;
  color: #ff4d4f;
}

.action-btn {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.card-body {
  padding: 20rpx 24rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row .label {
  font-size: 26rpx;
  color: #999;
  width: 120rpx;
}

.info-row .value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.info-row .amount {
  font-weight: bold;
  color: #ff4d4f;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.card-footer .time {
  font-size: 24rpx;
  color: #999;
}

.tags {
  display: flex;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.tag.offline {
  background: #fff7e6;
  color: #fa8c16;
}

.empty, .load-more {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

/* 操作菜单 */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.action-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 101;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.action-sheet.show {
  transform: translateY(0);
}

.action-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 30rpx;
  color: #333;
}

.action-item:last-child {
  border-bottom: none;
}

.action-item.cancel {
  color: #999;
  justify-content: center;
  margin-top: 16rpx;
}

.action-item.warn {
  color: #ff4d4f;
}

.action-icon {
  margin-right: 20rpx;
  font-size: 32rpx;
}