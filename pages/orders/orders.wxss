/* 订单列表样式 */
.orders-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.top-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.status-tabs {
  flex: 1;
  display: flex;
  white-space: nowrap;
}

.add-btn {
  width: 140rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: #1890ff;
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
  margin-left: 20rpx;
}

.tab {
  display: inline-block;
  padding: 10rpx 30rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 30rpx;
  background: #f0f0f0;
}

.tab.active {
  background: #1890ff;
  color: #fff;
}

.order-list {
  height: calc(100vh - 120rpx);
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.status-badge {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.status-badge.PENDING, .status-badge.DRAFT {
  background: #fff7e6;
  color: #fa8c16;
}

.status-badge.CONFIRMED {
  background: #e6f7ff;
  color: #1890ff;
}

.status-badge.SHIPPED, .status-badge.PARTIAL_SHIPPED {
  background: #f6ffed;
  color: #52c41a;
}

.status-badge.COMPLETED, .status-badge.SETTLED {
  background: #f0f5ff;
  color: #2f54eb;
}

.status-badge.CANCELLED, .status-badge.REJECTED {
  background: #fff1f0;
  color: #ff4d4f;
}

.card-body .info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.card-body .label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
}

.card-body .value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.card-body .amount {
  font-weight: bold;
  color: #ff4d4f;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.card-footer .time {
  font-size: 24rpx;
  color: #999;
}

.card-footer .more {
  font-size: 26rpx;
  color: #1890ff;
}

.empty, .load-more {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}