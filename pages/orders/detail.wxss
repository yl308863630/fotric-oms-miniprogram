/* 订单详情页样式 */
.detail-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.detail-scroll {
  height: 100vh;
  padding-bottom: 120rpx;
}

.status-card {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  padding: 32rpx;
  color: #fff;
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.status-label {
  font-size: 28rpx;
  opacity: 0.9;
}

.status-value {
  font-size: 32rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
}

.status-info {
  font-size: 26rpx;
  opacity: 0.8;
}

.section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 24rpx 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1890ff;
}

.info-list {
  padding-left: 16rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 26rpx;
  color: #999;
  min-width: 180rpx;
}

.info-item .value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  text-align: right;
}

/* 商品明细 */
.item-list {
  padding-left: 16rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.item-model {
  font-size: 24rpx;
  color: #999;
}

.item-right {
  text-align: right;
}

.item-qty {
  font-size: 26rpx;
  color: #999;
  display: block;
}

.item-amount {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 500;
}

.total-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}

.total-amount {
  color: #ff4d4f;
  font-size: 32rpx;
}

/* 子订单样式 */
.section-count {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: normal;
}

.child-order-list {
  padding-left: 16rpx;
}

.child-order-card {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.child-order-card:last-child {
  margin-bottom: 0;
}

.child-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.child-no {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.child-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  background: #e6f7ff;
  color: #1890ff;
}

.child-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
}

.child-amount {
  color: #ff4d4f;
  font-weight: 500;
}

.loading-small {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.bottom-space {
  height: 140rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.08);
}

.action-btn-list {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f5f5f5;
  color: #333;
  font-size: 26rpx;
  border-radius: 36rpx;
}

.action-btn.primary {
  background: #1890ff;
  color: #fff;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 80vh;
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 101;
}

.modal.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
}

.modal-content {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item .label {
  font-size: 28rpx;
  color: #333;
  min-width: 180rpx;
}

.required {
  color: #ff4d4f;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.confirm-tip {
  text-align: center;
  padding: 40rpx;
  color: #666;
  font-size: 28rpx;
}

.modal-btn {
  margin-top: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.upload-box {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.upload-box .upload-icon {
  font-size: 48rpx;
  color: #1890ff;
  margin-right: 16rpx;
}