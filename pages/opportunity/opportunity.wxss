/* 商机列表样式 */
.opportunity-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.search-bar {
  padding: 20rpx;
  background: #fff;
}

.search-input {
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

/* 状态页签 */
.status-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 20rpx;
  gap: 16rpx;
  overflow-x: auto;
}

.tab {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 28rpx;
  background: #f0f0f0;
}

.tab.active {
  background: #1890ff;
  color: #fff;
}

/* 工具栏 */
.toolbar {
  padding: 20rpx;
  background: #fff;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 商机列表 */
.opportunity-list {
  height: calc(100vh - 280rpx);
  padding: 20rpx;
}

.opportunity-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-info {
  flex: 1;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.customer-code {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.header-right {
  display: flex;
  align-items: center;
}

.stage-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.stage-tag.跟进中 { background: #e6f7ff; color: #1890ff; }
.stage-tag.已报价 { background: #fff7e6; color: #fa8c16; }
.stage-tag.已签约 { background: #f6ffed; color: #52c41a; }
.stage-tag.已流失 { background: #fff1f0; color: #ff4d4f; }

.action-btn {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.card-body {
  padding: 20rpx 24rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row .label {
  font-size: 26rpx;
  color: #999;
  width: 160rpx;
}

.info-row .value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.info-row .value.price {
  font-weight: bold;
  color: #ff4d4f;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.card-footer .time {
  font-size: 24rpx;
  color: #999;
}

.card-footer .sales {
  font-size: 24rpx;
  color: #666;
}

.empty, .load-more {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

/* 操作菜单 */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.action-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 101;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.action-sheet.show {
  transform: translateY(0);
}

.action-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 30rpx;
  color: #333;
}

.action-item:last-child {
  border-bottom: none;
}

.action-item.cancel {
  color: #999;
  justify-content: center;
  margin-top: 16rpx;
}

.action-item.warn {
  color: #ff4d4f;
}

.action-icon {
  margin-right: 20rpx;
  font-size: 32rpx;
}