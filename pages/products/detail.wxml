<!-- 商品详情/新建/编辑页面 -->
<view class="detail-page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  
  <view wx:else class="form-container">
    <!-- 商品图片 -->
    <view class="section">
      <view class="section-title">商品图片</view>
      <view class="image-upload" bindtap="chooseImage">
        <image wx:if="{{formData.image}}" src="{{formData.image}}" mode="aspectFill" class="product-image" />
        <view wx:else class="upload-placeholder">
          <text class="plus">+</text>
          <text class="tip">点击上传图片</text>
        </view>
      </view>
      <text class="image-tip">建议尺寸 800x800</text>
    </view>

    <!-- 基本信息 -->
    <view class="section">
      <view class="section-title">基本信息</view>
      
      <view class="form-item">
        <text class="required">*</text>
        <text class="label">商品名称</text>
        <input class="input" value="{{formData.name}}" data-field="name" bindinput="onInput" placeholder="请输入商品名称" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="required">*</text>
        <text class="label">商品编码</text>
        <input class="input" value="{{formData.code}}" data-field="code" bindinput="onInput" placeholder="请输入商品编码" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">条形码</text>
        <input class="input" value="{{formData.barcode}}" data-field="barcode" bindinput="onInput" placeholder="请输入条形码" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">物料号</text>
        <input class="input" value="{{formData.materialNo}}" data-field="materialNo" bindinput="onInput" placeholder="请输入物料号" disabled="{{action === 'view'}}" />
      </view>
    </view>

    <!-- 产品信息 -->
    <view class="section">
      <view class="section-title">产品信息</view>
      
      <view class="form-item">
        <text class="required">*</text>
        <text class="label">品牌</text>
        <input class="input" value="{{formData.brand}}" data-field="brand" bindinput="onInput" placeholder="请输入品牌" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">型号</text>
        <input class="input" value="{{formData.model}}" data-field="model" bindinput="onInput" placeholder="请输入型号" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">规格</text>
        <input class="input" value="{{formData.specs}}" data-field="specs" bindinput="onInput" placeholder="请输入规格" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">产品配置</text>
        <input class="input" value="{{formData.productConfig}}" data-field="productConfig" bindinput="onInput" placeholder="请输入产品配置" disabled="{{action === 'view'}}" />
      </view>
    </view>

    <!-- 交付信息 -->
    <view class="section">
      <view class="section-title">交付信息</view>
      
      <view class="form-item">
        <text class="label">交期</text>
        <input class="input" value="{{formData.deliveryPeriod}}" data-field="deliveryPeriod" bindinput="onInput" placeholder="例如：4-6周" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">产品保修期</text>
        <input class="input" value="{{formData.warrantyPeriod}}" data-field="warrantyPeriod" bindinput="onInput" placeholder="例如：1年" disabled="{{action === 'view'}}" />
      </view>
    </view>

    <!-- 价格库存 -->
    <view class="section">
      <view class="section-title">价格库存</view>
      
      <view class="form-item">
        <text class="required">*</text>
        <text class="label">单位</text>
        <input class="input" value="{{formData.unit}}" data-field="unit" bindinput="onInput" placeholder="例如：台" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">分类</text>
        <picker mode="selector" range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange" disabled="{{action === 'view'}}">
          <view class="picker-value">{{formData.categoryLabel || '请选择分类'}}</view>
        </picker>
      </view>
      
      <view class="form-item">
        <text class="label">销售价</text>
        <input class="input" type="digit" value="{{formData.price}}" data-field="price" bindinput="onNumberInput" placeholder="请输入销售价" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">库存</text>
        <input class="input" type="number" value="{{formData.stock}}" data-field="stock" bindinput="onNumberInput" placeholder="请输入库存" disabled="{{action === 'view'}}" />
      </view>
    </view>

    <!-- 其他信息 -->
    <view class="section">
      <view class="section-title">其他信息</view>
      
      <view class="form-item">
        <text class="label">链接</text>
        <textarea class="textarea" value="{{formData.competitorLink}}" data-field="competitorLink" bindinput="onInput" placeholder="请输入竞品链接，多个用换行分隔" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item">
        <text class="label">备注</text>
        <textarea class="textarea" value="{{formData.remark}}" data-field="remark" bindinput="onInput" placeholder="请输入备注" disabled="{{action === 'view'}}" />
      </view>
      
      <view class="form-item switch-item" wx:if="{{action !== 'create'}}">
        <text class="label">状态</text>
        <switch checked="{{formData.isActive}}" bindchange="onStatusChange" disabled="{{action === 'view'}}" />
        <text class="switch-label">{{formData.isActive ? '上架' : '下架'}}</text>
      </view>
    </view>

    <!-- 时间信息 -->
    <view class="section" wx:if="{{action === 'view'}}">
      <view class="section-title">时间信息</view>
      <view class="form-item">
        <text class="label">创建时间</text>
        <text class="value">{{formData.createTime || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="label">更新时间</text>
        <text class="value">{{formData.updateTime || '-'}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar" wx:if="{{action !== 'view'}}">
      <button class="btn-submit" bindtap="handleSubmit" disabled="{{submitting}}">
        {{submitting ? '提交中...' : (action === 'create' ? '新增商品' : '保存修改')}}
      </button>
    </view>
    
    <view class="action-bar" wx:if="{{action === 'view' && canSave}}">
      <button class="btn-edit" bindtap="handleEdit">编辑商品</button>
      <button class="btn-delete" bindtap="handleDelete">删除商品</button>
    </view>
  </view>
</view>