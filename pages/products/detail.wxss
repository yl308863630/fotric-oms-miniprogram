/* 商品详情 */
.detail-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.loading, .empty {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

.content {
  padding: 20rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.status.ACTIVE {
  background: #f6ffed;
  color: #52c41a;
}

.status.INACTIVE {
  background: #fff1f0;
  color: #ff4d4f;
}

.section {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row .label {
  font-size: 26rpx;
  color: #999;
}

.info-row .value {
  font-size: 26rpx;
  color: #333;
}

.info-row .value.price {
  color: #ff4d4f;
  font-weight: bold;
}

.description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}