/* 主链观察页面 */
.chain-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.search-bar {
  padding: 20rpx;
  background: #fff;
}

.search-input {
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

/* 主单列表 */
.master-list {
  padding: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.order-list {
  height: calc(100vh - 200rpx);
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.status-badge.待指派, .status-badge.PENDING { background: #fff7e6; color: #fa8c16; }
.status-badge.待确认 { background: #e6f7ff; color: #1890ff; }
.status-badge.待发货 { background: #fff7e6; color: #fa8c16; }
.status-badge.待签收 { background: #fff7e6; color: #fa8c16; }
.status-badge.待对账 { background: #f9f0ff; color: #722ed1; }
.status-badge.待开票 { background: #f9f0ff; color: #722ed1; }
.status-badge.待结算 { background: #fff7e6; color: #fa8c16; }
.status-badge.已完成 { background: #f6ffed; color: #52c41a; }
.status-badge.已取消 { background: #fff1f0; color: #ff4d4f; }

.card-body {
  padding: 16rpx 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.info-row .label {
  font-size: 26rpx;
  color: #999;
}

.info-row .value {
  font-size: 26rpx;
  color: #333;
}

.info-row .value.price {
  font-weight: bold;
  color: #ff4d4f;
}

/* 链路详情 */
.chain-detail {
  padding: 20rpx;
}

.back-bar {
  margin-bottom: 20rpx;
}

.back-btn {
  font-size: 28rpx;
  color: #1890ff;
}

.master-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 时间线 */
.chain-timeline {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.timeline-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.timeline-item {
  position: relative;
  padding-left: 40rpx;
  padding-bottom: 30rpx;
  border-left: 2rpx solid #e8e8e8;
}

.timeline-item:last-child {
  border-left: none;
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -8rpx;
  top: 0;
  width: 16rpx;
  height: 16rpx;
  background: #1890ff;
  border-radius: 50%;
}

.timeline-content {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.timeline-body {
  display: flex;
  font-size: 26rpx;
  padding: 4rpx 0;
}

.timeline-body .label {
  color: #999;
}

.timeline-body .value {
  color: #333;
}

.timeline-body .value.price {
  font-weight: bold;
  color: #ff4d4f;
}

.empty {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}