<!-- 主链观察页面 -->
<view class="chain-page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="输入OMS单号/主单号搜索" bindconfirm="onSearch" />
  </view>

  <!-- 主单列表模式 -->
  <view wx:if="{{currentTab === 'master'}}" class="master-list">
    <view class="section-title">主单列表</view>
    <scroll-view class="order-list" scroll-y>
      <view class="order-card" wx:for="{{masterOrders}}" wx:key="id" bindtap="selectMaster" data-item="{{item}}">
        <view class="card-header">
          <text class="order-no">{{item.orderNo || item.masterNo}}</text>
          <text class="status-badge {{item.masterStatus}}">{{item.masterStatus || item.status}}</text>
        </view>
        <view class="card-body">
          <view class="info-row">
            <text class="label">甲方</text>
            <text class="value">{{item.partyAName || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="label">金额</text>
            <text class="value price">¥{{item.amount || 0}}</text>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{!masterOrders.length && !loading}}">
        <text>暂无主单</text>
      </view>
    </scroll-view>
  </view>

  <!-- 链路详情模式 -->
  <view wx:if="{{currentTab === 'chain' && selectedMaster}}" class="chain-detail">
    <!-- 返回按钮 -->
    <view class="back-bar">
      <text class="back-btn" bindtap="goBack">← 返回主单列表</text>
    </view>

    <!-- 主单信息 -->
    <view class="master-card">
      <view class="card-title">主单信息</view>
      <view class="info-row">
        <text class="label">主单号</text>
        <text class="value">{{selectedMaster.orderNo || selectedMaster.masterNo}}</text>
      </view>
      <view class="info-row">
        <text class="label">甲方</text>
        <text class="value">{{selectedMaster.partyAName || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="label">状态</text>
        <text class="value">{{selectedMaster.masterStatus || selectedMaster.status}}</text>
      </view>
      <view class="info-row">
        <text class="label">金额</text>
        <text class="value price">¥{{selectedMaster.amount || 0}}</text>
      </view>
    </view>

    <!-- 链路图示 -->
    <view class="chain-timeline">
      <view class="timeline-title">订单链路</view>
      <view class="timeline-item" wx:for="{{allocations}}" wx:key="id">
        <view class="timeline-dot"></view>
        <view class="timeline-content" bindtap="goToOrderDetail" data-id="{{item.id}}">
          <view class="timeline-header">
            <text class="order-no">{{item.orderNo}}</text>
            <text class="status-badge {{item.status}}">{{item.status}}</text>
          </view>
          <view class="timeline-body">
            <text class="label">乙方：</text>
            <text class="value">{{item.partyBName || '-'}}</text>
          </view>
          <view class="timeline-body">
            <text class="label">金额：</text>
            <text class="value price">¥{{item.amount || 0}}</text>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{!allocations.length}}">
        <text>暂无子单</text>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>